{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resiliencebenchmark.local/resilience-agent/model-defect-assessment.v0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_summary", "findings", "rejected_seed_candidates", "coverage_notes"],
  "properties": {
    "schema_version": {"type": "string", "const": "model-defect-assessment.v0.1"},
    "analysis_summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "rejected_seed_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "reason"],
        "properties": {
          "candidate_id": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "coverage_notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_count", "signal_summary"],
      "properties": {
        "path": {"type": "string"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_count": {"type": "integer", "minimum": 1, "maximum": 240},
        "signal_summary": {"type": "string"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defect_ref",
        "target_component",
        "confidence_score",
        "evidence_refs",
        "mechanism_reasoning",
        "matched_conditions",
        "missing_safeguards",
        "alternative_explanations",
        "validation_requirements"
      ],
      "properties": {
        "defect_ref": {"type": "string", "pattern": "^RBD-[0-9]{3}$"},
        "target_component": {"type": "string", "minLength": 1},
        "confidence_score": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceRef"}
        },
        "mechanism_reasoning": {"type": "string"},
        "matched_conditions": {"type": "array", "items": {"type": "string"}},
        "missing_safeguards": {"type": "array", "items": {"type": "string"}},
        "alternative_explanations": {"type": "array", "items": {"type": "string"}},
        "validation_requirements": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
