{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resiliencebenchmark.local/resilience-agent/candidate-defects.v0.1.json",
  "title": "Candidate Resilience Defects",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "generated_at",
    "analysis_mode",
    "model_provenance",
    "model_review",
    "project",
    "template_registry",
    "scan_summary",
    "candidates"
  ],
  "properties": {
    "schema_version": {"const": "candidate-defects.v0.1"},
    "analysis_id": {"type": "string", "pattern": "^ANALYSIS-[a-f0-9]{12}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "analysis_mode": {"enum": ["static_candidate_identification", "hybrid_model_assisted"]},
    "model_provenance": {
      "type": ["object", "null"],
      "properties": {
        "provider": {"type": "string"},
        "protocol": {"type": "string"},
        "requested_model": {"type": "string"},
        "resolved_model": {"type": ["string", "null"]},
        "reasoning_effort": {"type": "string"},
        "store": {"type": "boolean"},
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "total_tokens"],
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "total_tokens": {"type": "integer", "minimum": 0}
          }
        }
      },
      "required": ["provider", "protocol", "requested_model", "resolved_model", "reasoning_effort", "store", "usage"],
      "additionalProperties": false
    },
    "model_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_summary", "rejected_seed_candidates", "invalid_findings", "coverage_notes"],
      "properties": {
        "analysis_summary": {"type": "string"},
        "rejected_seed_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "reason"],
            "properties": {
              "candidate_id": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        },
        "invalid_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["defect_ref", "target_component", "reason"],
            "properties": {
              "defect_ref": {"type": "string"},
              "target_component": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        },
        "coverage_notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "application", "context"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "application": {"type": "string", "minLength": 1},
        "context": {"type": "object"}
      }
    },
    "template_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_version", "matcher_registry_version"],
      "properties": {
        "catalog_version": {"type": "string", "minLength": 1},
        "matcher_registry_version": {"type": "string", "minLength": 1}
      }
    },
    "scan_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_scanned",
        "templates_total",
        "templates_with_deterministic_matchers",
        "rules_evaluated",
        "candidate_count",
        "coverage_note"
      ],
      "properties": {
        "files_scanned": {"type": "integer", "minimum": 0},
        "templates_total": {"type": "integer", "minimum": 1},
        "templates_with_deterministic_matchers": {"type": "integer", "minimum": 0},
        "rules_evaluated": {"type": "integer", "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 0},
        "coverage_note": {"type": "string", "minLength": 1}
      }
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "defect_ref",
        "title",
        "family",
        "status",
        "confidence",
        "confidence_score",
        "target",
        "match_rule_ids",
        "evidence",
        "reasoning",
        "validation_requirements",
        "planning_hints"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^CAND-RBD-[0-9]{3}-[a-f0-9]{12}$"},
        "defect_ref": {"type": "string", "pattern": "^RBD-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "status": {"const": "candidate_unverified"},
        "confidence": {"enum": ["low", "medium", "high"]},
        "confidence_score": {"type": "number", "minimum": 0, "maximum": 1},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["component", "artifacts"],
          "properties": {
            "component": {"type": "string", "minLength": 1},
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "match_rule_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "reasoning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanism", "matched_conditions", "missing_safeguards", "alternative_explanations"],
          "properties": {
            "mechanism": {"type": "string", "minLength": 1},
            "matched_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "missing_safeguards": {"type": "array", "items": {"type": "string"}},
            "alternative_explanations": {"type": "array", "items": {"type": "string"}}
          }
        },
        "validation_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "planning_hints": {"$ref": "#/$defs/planningHints"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "line_start", "line_end", "signal_id", "summary", "excerpt"],
      "properties": {
        "kind": {"enum": ["source", "config", "system"]},
        "path": {"type": "string", "minLength": 1},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "signal_id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string"}
      }
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string"}
    },
    "observableEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "traces", "logs", "kubernetes", "source"],
      "properties": {
        "metrics": {"$ref": "#/$defs/stringArray"},
        "traces": {"$ref": "#/$defs/stringArray"},
        "logs": {"$ref": "#/$defs/stringArray"},
        "kubernetes": {"$ref": "#/$defs/stringArray"},
        "source": {"$ref": "#/$defs/stringArray"}
      }
    },
    "planningHints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_class",
        "actuator_candidates",
        "parameters",
        "guardrails",
        "expected_degradation",
        "slo_impact",
        "observable_evidence",
        "cleanup",
        "recovery_verification"
      ],
      "properties": {
        "trigger_class": {"type": "string", "minLength": 1},
        "actuator_candidates": {"$ref": "#/$defs/stringArray"},
        "parameters": {"$ref": "#/$defs/stringArray"},
        "guardrails": {"$ref": "#/$defs/stringArray"},
        "expected_degradation": {"type": "string", "minLength": 1},
        "slo_impact": {"type": "string", "minLength": 1},
        "observable_evidence": {"$ref": "#/$defs/observableEvidence"},
        "cleanup": {"$ref": "#/$defs/stringArray"},
        "recovery_verification": {"$ref": "#/$defs/stringArray"}
      }
    }
  }
}
