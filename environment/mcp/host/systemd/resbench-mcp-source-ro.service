[Unit]
Description=ResilienceBenchmark MCP source_ro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=resbench-source-ro
Group=resbench-source-ro
WorkingDirectory=/opt/resiliencebenchmark/repo
EnvironmentFile=/etc/resiliencebenchmark/mcp/source_ro.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=RESBENCH_MCP_TRANSPORT=streamable-http
Environment=RESBENCH_MCP_HTTP_HOST=127.0.0.1
Environment=RESBENCH_MCP_HTTP_PORT=18083
Environment=RESBENCH_MCP_HTTP_PATH=/mcp
ExecStart=/opt/resiliencebenchmark/repo/.venv/bin/python -m mcp_servers.source_ro
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/resiliencebenchmark/repo /etc/resiliencebenchmark -/opt/resiliencebenchmark/sources
UMask=0077

[Install]
WantedBy=multi-user.target
