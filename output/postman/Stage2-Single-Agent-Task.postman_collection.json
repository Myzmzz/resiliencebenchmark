            "type": "text/javascript",
            "exec": [
              "pm.test('task list succeeded', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.expect(body.tasks).to.be.an('array');",
              "pm.expect(body.task_count).to.be.at.least(1);",
              "const current = body.tasks.find(item => item.task_id === pm.collectionVariables.get('taskId'));",
              "pm.expect(current).to.be.an('object');",
              "pm.expect(current.suite.total_trials).to.eql(7);"
            ]
          }
        }
      ]
    },
