              "const body = pm.response.json();",
              "pm.expect(body.mode).to.eql('debug');",
              "pm.expect(body.events).to.be.an('array');",
              "if (body.events.length > 0) {",
              "  pm.expect(body.events[0]).to.have.property('payload');",
              "  pm.expect(body.events[0]).to.have.property('event_class');",
              "}"
            ]
          }
        }
      ]
    },
