              "pm.test('environment reset accepted', function () { pm.response.to.have.status(202); });",
              "pm.collectionVariables.set('afterSequence', '-1');"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Revoke all Trial-scoped Agent access",
      "request": {
