        "url": {
          "raw": "{{baseUrl}}/api/v1/stage2/tasks/{{taskId}}/environment/reset",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "stage2", "tasks", "{{taskId}}", "environment", "reset"]
