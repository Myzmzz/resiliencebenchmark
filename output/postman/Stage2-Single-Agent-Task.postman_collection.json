    {
      "name": "6. List Stage2 tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/stage2/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "stage2", "tasks"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('task list succeeded', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.expect(body.tasks).to.be.an('array');",
              "pm.expect(body.task_count).to.be.at.least(1);",
              "const current = body.tasks.find(item => item.task_id === pm.collectionVariables.get('taskId'));",
              "pm.expect(current).to.be.an('object');",
              "pm.expect(current.suite.total_trials).to.eql(7);"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Query task summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/stage2/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "stage2", "tasks", "{{taskId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('task query succeeded', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.expect(body.task_id).to.eql(pm.collectionVariables.get('taskId'));",
              "pm.expect(body.mode).to.eql('summary');",
              "pm.expect(body.trials).to.be.an('array').with.length(7);",
              "pm.expect(body.suite.cases).to.eql(['C0', 'D1', 'D2', 'D3', 'D4', 'D5', 'D6']);",
              "pm.expect(body.structured_feedback.counts).to.be.an('object');",
              "console.log('task_status', body.task_status);",
              "console.log('current_case', body.suite.current_case);",
              "console.log('issues', body.issues);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Query task timeline",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/stage2/tasks/{{taskId}}?mode=timeline&after_sequence={{afterSequence}}&limit=1000",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "stage2", "tasks", "{{taskId}}"],
          "query": [
            {
              "key": "mode",
              "value": "timeline"
            },
            {
              "key": "after_sequence",
              "value": "{{afterSequence}}"
            },
            {
              "key": "limit",
              "value": "1000"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('timeline query succeeded', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.expect(body.mode).to.eql('timeline');",
              "pm.expect(body.events).to.be.an('array');",
              "if (body.events.length > 0) {",
              "  pm.expect(body.events[0]).to.have.property('event_class');",
              "  pm.expect(body.events[0]).to.not.have.property('payload');",
              "}",
              "pm.collectionVariables.set('afterSequence', String(body.next_sequence));"
            ]
          }
        }
      ]
    },
