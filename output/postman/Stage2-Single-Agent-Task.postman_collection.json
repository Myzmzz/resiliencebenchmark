            "exec": [
              "pm.test('task query succeeded', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.expect(body.task_id).to.eql(pm.collectionVariables.get('taskId'));",
              "pm.expect(body.mode).to.eql('summary');",
              "pm.expect(body.trials).to.be.an('array').with.length(7);",
              "pm.expect(body.suite.cases).to.eql(['C0', 'D1', 'D2', 'D3', 'D4', 'D5', 'D6']);",
              "pm.expect(body.structured_feedback.counts).to.be.an('object');",
              "if (body.pending_question) { pm.collectionVariables.set('questionId', body.pending_question.question_id); }",
              "pm.expect(body).to.have.property('behavioral_evaluation');",
              "console.log('task_status', body.task_status);",
              "console.log('current_case', body.suite.current_case);",
              "console.log('issues', body.issues);"
            ]
          }
        }
