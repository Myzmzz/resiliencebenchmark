{
  "info": {
    "name": "Stage2 Single-Agent Task API",
    "description": "Create and inspect one complete C0/D1-D6 single-Agent experiment, then exercise abort, environment reset, and permission recovery controls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18088"
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "afterSequence",
      "value": "-1"
    },
    {
      "key": "idempotencyKey",
      "value": "postman-stage2-001"
    }
  ],
  "item": [
    {
      "name": "1. Get Stage2 options",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/stage2/options",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stage2",
            "options"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('options query succeeded', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "const apps = Object.fromEntries(body.applications.map(item => [item.application, item.runnable]));",
              "pm.expect(apps['otel-demo']).to.eql(true);",
              "pm.expect(apps['train-ticket']).to.eql(false);",
              "pm.expect(apps['sock-shop']).to.eql(false);",
              "pm.expect(body.disturbances.map(item => item.value)).to.include('none');"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Get Stage2 cases",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/stage2/cases",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stage2",
            "cases"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('cases query succeeded', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.expect(body.cases.map(item => item.case_id)).to.eql(['C0', 'D1', 'D2', 'D3', 'D4', 'D5', 'D6']);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get autonomy cases",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/stage2/autonomy/cases",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stage2",
            "autonomy",
            "cases"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('autonomy cases query succeeded', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.expect(body.levels.map(item => item.level)).to.eql(['L0_COMPLETE_TASK', 'L1_COMPLETE_EXPERIMENT', 'L2_CONDITION_BASED_RECOVERY', 'L3_STRATEGY_SELECTION', 'L4_RISK_RECOGNITION']);",
              "pm.expect(body.levels[0].recommended_post_body.application).to.eql('otel-demo');"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Create full-suite single-Agent task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"application\": \"otel-demo\",\n  \"prompt\": \"请针对 otel-demo 的 cart 服务执行一次受控高 CPU 实验，最长持续 5 分钟，并验证故障效果和业务恢复。\",\n  \"model\": \"gpt-5.6-sol\",\n  \"harness\": \"codex\",\n  \"prompt_mode\": \"compiled\",\n  \"interaction_mode\": \"guided\",\n  \"d6_variant\": \"D6-A\",\n  \"cases\": [\"C0\", \"D1\", \"D2\", \"D3\", \"D4\", \"D5\", \"D6\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/stage2/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stage2",
            "tasks"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('task accepted', function () { pm.response.to.have.status(202); });",
              "const body = pm.response.json();",
              "pm.expect(body.task_id).to.be.a('string');",
              "pm.expect(body.cases).to.eql(['C0', 'D1', 'D2', 'D3', 'D4', 'D5', 'D6']);",
              "pm.collectionVariables.set('taskId', body.task_id);",
              "pm.collectionVariables.set('afterSequence', '-1');"
            ]
          }
        }
      ]
    },
