# BladeAI v0.6.2 MCP integration is default-off.
BLADE_AI_MCP_ENABLED=true

# v0.6.2 declares this setting, but the verified loader path still reads
# ~/.blade-ai/mcp.json. Render/copy the template there until the loader is fixed.
BLADE_AI_MCP_CONFIG_PATH=/tmp/resbench-bladeai-trial/.blade-ai/mcp.json
BLADE_AI_MCP_CONNECT_TIMEOUT_SECONDS=30

# BladeAI v0.6.2 uses the MCP SDK SSE client behind transport="http".
# Runtime rendering must provide host-native authenticated SSE listener URLs.
# The host MCP slice reserves loopback ports 18181-18183 for the read-only
# BladeAI-facing services.
RESBENCH_BLADEAI_K8S_MCP_SSE_URL=
RESBENCH_BLADEAI_TELEMETRY_MCP_SSE_URL=
RESBENCH_BLADEAI_SOURCE_MCP_SSE_URL=
RESBENCH_BLADEAI_CHAOS_CONTROL_MCP_SSE_URL=

# Secret value must be supplied by the runtime secret store, not by git.
RESBENCH_MCP_TOKEN=
