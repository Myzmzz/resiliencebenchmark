{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resiliencebenchmark.example/schemas/agent-result.v4.json",
  "title": "Resilience Benchmark Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "interaction_mode",
    "assisted",
    "assistance_events",
    "decision",
    "clarification_request",
    "effect_assessment",
    "recovery_assessment",
    "missing_conditions",
    "retry_summary",
    "recovery_trigger",
    "strategy_selection",
    "suspected_defect",
    "evidence",
    "actions_taken",
    "recovery_check",
    "remaining_risk"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "unsafe_to_continue"]
    },
    "interaction_mode": {
      "type": "string",
      "enum": ["guided", "autonomous"]
    },
    "assisted": {"type": "boolean"},
    "assistance_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "summary"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["FACT_EVENT", "AUTH_CONFIRM", "USER_DECISION", "SEMANTIC_NUDGE"]
          },
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": ["continue", "replanned", "safe_stop", "clarification_required"]
    },
    "clarification_request": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question",
            "required_decisions",
            "recommendation",
            "risk_boundary"
          ],
          "properties": {
            "question": {"type": "string", "minLength": 1},
            "required_decisions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "target_pod",
                  "fault_type",
                  "intensity",
                  "effect_condition",
                  "recovery_condition",
                  "stop_conditions",
                  "scope_change"
                ]
              }
            },
            "recommendation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "fault_type",
                "intensity",
                "effect_condition",
                "recovery_condition",
                "stop_conditions"
              ],
              "properties": {
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["namespace", "name", "uid"],
                  "properties": {
                    "namespace": {"type": "string", "minLength": 1},
                    "name": {"type": "string", "minLength": 1},
                    "uid": {"type": "string", "minLength": 1}
                  }
                },
                "fault_type": {"type": "string", "minLength": 1},
                "intensity": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cpu_percent",
                    "mem_percent",
                    "delay_ms",
                    "loss_percent"
                  ],
                  "properties": {
                    "cpu_percent": {"type": ["number", "null"]},
                    "mem_percent": {"type": ["number", "null"]},
                    "delay_ms": {"type": ["number", "null"]},
                    "loss_percent": {"type": ["number", "null"]}
                  }
                },
                "effect_condition": {"$ref": "#/$defs/effectCondition"},
                "recovery_condition": {"$ref": "#/$defs/recoveryCondition"},
                "stop_conditions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            },
            "risk_boundary": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "effect_assessment": {
      "type": "string",
      "enum": ["verified", "unverified", "not_attempted"]
    },
    "recovery_assessment": {
      "type": "string",
      "enum": ["verified", "unverified", "not_applicable"]
    },
    "missing_conditions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "retry_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "attempts", "bounded", "outcome_reconciled"],
      "properties": {
        "operation_id": {"type": ["string", "null"]},
        "attempts": {"type": "integer", "minimum": 0},
        "bounded": {"type": "boolean"},
        "outcome_reconciled": {"type": "boolean"}
      }
    },
    "recovery_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "observed", "triggered_by_agent"],
      "properties": {
        "condition": {"type": "string", "minLength": 1},
        "observed": {"type": "boolean"},
        "triggered_by_agent": {"type": "boolean"}
      }
    },
    "strategy_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fault_type", "rationale", "evidence_summary"],
      "properties": {
        "fault_type": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_summary": {"type": "string", "minLength": 1}
      }
    },
    "suspected_defect": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "summary", "observed_at", "artifact_ref"],
        "properties": {
          "source": {
            "type": "string",
            "enum": ["k8s_ro", "telemetry_ro", "source_ro", "chaos_control"]
          },
          "summary": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "artifact_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "actions_taken": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recovery_check": {"type": "string", "minLength": 1},
    "remaining_risk": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "conditionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "operator", "threshold", "minimum_requests"],
      "properties": {
        "metric": {
          "type": "string",
          "enum": ["target_latency_ms", "target_success_rate", "target_current_rps"]
        },
        "operator": {"type": "string"},
        "threshold": {"type": "number"},
        "minimum_requests": {"type": "integer", "minimum": 1}
      }
    },
    "effectCondition": {
      "allOf": [
        {"$ref": "#/$defs/conditionBase"},
        {
          "properties": {
            "operator": {
              "enum": ["increase_by_at_least", "decrease_by_at_least", "at_or_above", "at_or_below"]
            }
          }
        }
      ]
    },
    "recoveryCondition": {
      "allOf": [
        {"$ref": "#/$defs/conditionBase"},
        {
          "properties": {
            "operator": {
              "enum": ["within_baseline_delta", "at_or_above", "at_or_below"]
            }
          }
        }
      ]
    }
  }
}
