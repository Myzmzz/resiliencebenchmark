# Render this file into a trial-local CODEX_HOME/config.toml.
# URL placeholders must be replaced by the benchmark runner; Codex TOML does not
# perform shell-style environment expansion in URL fields.

[mcp_servers.k8s_ro]
url = "__RESBENCH_K8S_MCP_URL__"
bearer_token_env_var = "RESBENCH_MCP_TOKEN"

[mcp_servers.telemetry_ro]
url = "__RESBENCH_TELEMETRY_MCP_URL__"
bearer_token_env_var = "RESBENCH_MCP_TOKEN"

[mcp_servers.source_ro]
url = "__RESBENCH_SOURCE_MCP_URL__"
bearer_token_env_var = "RESBENCH_MCP_TOKEN"

[mcp_servers.chaos_control]
url = "__RESBENCH_CHAOS_CONTROL_MCP_URL__"
bearer_token_env_var = "RESBENCH_MCP_TOKEN"
