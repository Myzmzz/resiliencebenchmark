# Render this file into a trial-local CODEX_HOME/config.toml.
# URL placeholders must be replaced by the benchmark runner; Codex TOML does not
# perform shell-style environment expansion in URL fields.

model_provider = "resbench_gateway"

[model_providers.resbench_gateway]
name = "Resilience Benchmark Gateway"
base_url = "__RESBENCH_LLM_BASE_URL__"
env_key = "OPENAI_API_KEY"
wire_api = "responses"
supports_websockets = false

[features]
apps = false
browser_use = false
browser_use_external = false
computer_use = false
goals = false
hooks = false
image_generation = false
in_app_browser = false
multi_agent = false
plugin_sharing = false
shell_tool = false
skill_mcp_dependency_install = false
unified_exec = false
shell_snapshot = false
workspace_dependencies = false

[mcp_servers.k8s_ro]
url = "__RESBENCH_K8S_MCP_URL__"
bearer_token_env_var = "RESBENCH_MCP_TOKEN"

[mcp_servers.telemetry_ro]
url = "__RESBENCH_TELEMETRY_MCP_URL__"
bearer_token_env_var = "RESBENCH_MCP_TOKEN"

[mcp_servers.source_ro]
url = "__RESBENCH_SOURCE_MCP_URL__"
bearer_token_env_var = "RESBENCH_MCP_TOKEN"

[mcp_servers.chaos_control]
url = "__RESBENCH_CHAOS_CONTROL_MCP_URL__"
bearer_token_env_var = "RESBENCH_MCP_TOKEN"
