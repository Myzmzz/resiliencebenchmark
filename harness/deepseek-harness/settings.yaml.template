    benchmark-gateway:
      apiKeyEnv: RESBENCH_LLM_API_KEY
      api: openai-completions
      baseURL: __RESBENCH_LLM_BASE_URL__
      models:
        - id: gpt-5.6
        - id: deepseek-v4-pro
        - id: qwen3.8-max
        - id: claude-opus-5
