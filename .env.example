# Local paths and environment selection
BENCHMARK_KUBECONFIG=
BENCHMARK_ENVIRONMENT_ID=
BENCHMARK_ARTIFACT_DIR=artifacts
RESBENCH_HARNESS_HOST=
RESBENCH_SSH_BOOTSTRAP_IDENTITY=

# Registry references. Credentials must come from a runtime secret source.
HARBOR_REGISTRY=
HARBOR_PROJECT=
HARBOR_PROJECT_TRAIN_TICKET=
HARBOR_PROJECT_SOCK_SHOP=
HARBOR_PROJECT_OTEL_DEMO=
HARBOR_PROJECT_OBSERVABILITY=
HARBOR_ROBOT_USERNAME=
HARBOR_ROBOT_TOKEN=

# OpenAI-compatible or provider-specific model gateway.
RESBENCH_LLM_BASE_URL=
RESBENCH_LLM_API_KEY=
RESBENCH_KUBECONFIG_REF=
RESBENCH_SOURCE_INDEX_REF=
RESBENCH_CLAUDE_HOME=
RESBENCH_CODEX_HOME=
DSH_HOME=
RESBENCH_K8S_MCP_URL=
RESBENCH_PROMETHEUS_MCP_URL=
RESBENCH_JAEGER_MCP_URL=
RESBENCH_LOKI_MCP_URL=
RESBENCH_SOURCE_MCP_URL=
RESBENCH_CHAOS_CONTROL_MCP_URL=
RESBENCH_MCP_TOKEN=

# Native provider credentials, only when a Harness requires that protocol.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Read-only observability MCP endpoints and credentials.
PROMETHEUS_URL=
JAEGER_MCP_URL=
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Controller and Oracle use different credentials and service accounts.
CONTROLLER_SERVICE_ACCOUNT=
ORACLE_SERVICE_ACCOUNT=
MCP_BEARER_TOKEN=

# Approved Run execution worker. Values are provisioned only on the Controller
# host; the Web API never accepts or returns them.
RESBENCH_KUBECONFIG=
RESBENCH_LOCUST_WORKLOAD_IMAGE=
RESBENCH_CHAOS_BASELINE_LEDGER_DIR=/var/lib/resiliencebenchmark/chaos-control/baseline
RESBENCH_PRIVATE_RUNTIME_ROOT=/var/lib/resiliencebenchmark/control-worker/private
RESBENCH_TELEMETRY_DISTURBANCE_DIR=/var/lib/resiliencebenchmark/telemetry-disturbance
RESBENCH_CHAOS_CONTROLLER_TOKEN_REF=
RESBENCH_CHAOS_CONTROLLER_POD_UID=
