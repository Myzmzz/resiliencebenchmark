{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resiliencebenchmark.local/evaluator/oracle-observation.schema.json",
  "title": "ResilienceBenchmark Oracle Observation",
  "type": "object",
  "required": ["schema_version", "episode_id", "gate_results"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "gate_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate_id", "status", "evidence_sources"],
        "additionalProperties": false,
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "INCONCLUSIVE", "CASE_INVALID"]
          },
          "reason": {
            "type": "string"
          },
          "evidence_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "ref"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "independent_observer",
                    "runtime_system",
                    "source_code",
                    "controller_record",
                    "human_review",
                    "agent_self_report"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
