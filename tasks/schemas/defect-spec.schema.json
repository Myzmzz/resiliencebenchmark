{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/resiliencebenchmark/tasks/schemas/defect-spec.schema.json",
  "title": "Resilience Benchmark DefectSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "defect_id",
    "title",
    "status",
    "family",
    "summary",
    "latent_defect",
    "fault_trigger",
    "failure_outcome",
    "app_candidates",
    "observable_evidence",
    "recovery",
    "leakage_controls"
  ],
  "properties": {
    "schema_version": {
      "const": "defect-spec.v0.1"
    },
    "defect_id": {
      "type": "string",
      "pattern": "^RBD-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "enum": [
        "candidate",
        "calibrating",
        "validated",
        "retired"
      ]
    },
    "family": {
      "enum": [
        "timeout",
        "retry",
        "isolation",
        "capacity",
        "health",
        "availability",
        "messaging",
        "consistency",
        "compatibility",
        "caching",
        "discovery"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "latent_defect": {
      "$ref": "#/$defs/latentDefect"
    },
    "fault_trigger": {
      "$ref": "#/$defs/faultTrigger"
    },
    "failure_outcome": {
      "$ref": "#/$defs/failureOutcome"
    },
    "app_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/appCandidate"
      }
    },
    "observable_evidence": {
      "$ref": "#/$defs/observableEvidence"
    },
    "recovery": {
      "$ref": "#/$defs/recovery"
    },
    "leakage_controls": {
      "$ref": "#/$defs/leakageControls"
    },
    "evaluator_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "latentDefect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "mechanism",
        "likely_locations",
        "risk_conditions"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 20
        },
        "mechanism": {
          "type": "string",
          "minLength": 20
        },
        "likely_locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "risk_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "faultTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_class",
        "actuator_candidates",
        "parameters",
        "guardrails"
      ],
      "properties": {
        "trigger_class": {
          "enum": [
            "latency",
            "packet_loss",
            "http_error",
            "dns_fault",
            "process_kill",
            "cpu_pressure",
            "memory_pressure",
            "io_pressure",
            "pod_restart",
            "node_disruption",
            "dependency_unavailable",
            "workload_spike",
            "message_delay",
            "message_duplicate",
            "message_poison",
            "config_rollout",
            "cache_flush",
            "clock_skew"
          ]
        },
        "actuator_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "guardrails": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "failureOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slo_impact",
        "user_visible_symptom",
        "expected_degradation",
        "invalid_outcomes"
      ],
      "properties": {
        "slo_impact": {
          "type": "string",
          "minLength": 10
        },
        "user_visible_symptom": {
          "type": "string",
          "minLength": 10
        },
        "expected_degradation": {
          "type": "string",
          "minLength": 10
        },
        "invalid_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "appCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app",
        "fit",
        "candidate_targets"
      ],
      "properties": {
        "app": {
          "enum": [
            "train-ticket",
            "sock-shop",
            "otel-demo"
          ]
        },
        "fit": {
          "enum": [
            "primary",
            "secondary",
            "possible"
          ]
        },
        "candidate_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "observableEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics",
        "traces",
        "logs",
        "kubernetes",
        "source"
      ],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kubernetes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanup",
        "verification"
      ],
      "properties": {
        "cleanup": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "leakageControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_visible",
        "public_hints",
        "forbidden_disclosures",
        "answer_leakage_risks"
      ],
      "properties": {
        "agent_visible": {
          "type": "boolean"
        },
        "public_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_disclosures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "answer_leakage_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
