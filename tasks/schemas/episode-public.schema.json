{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/resiliencebenchmark/tasks/schemas/episode-public.schema.json",
  "title": "Resilience Benchmark EpisodePublic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "title",
    "status",
    "application",
    "agent_goal",
    "environment_snapshot",
    "workload",
    "observability",
    "source_access",
    "action_space",
    "budget",
    "safety_constraints",
    "expected_agent_output",
    "leakage_controls"
  ],
  "properties": {
    "schema_version": {
      "const": "episode-public.v0.1"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^EPI-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "enum": [
        "example",
        "draft",
        "calibrating",
        "locked",
        "retired"
      ]
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "namespace",
        "candidate_services"
      ],
      "properties": {
        "name": {
          "enum": [
            "train-ticket",
            "sock-shop",
            "otel-demo"
          ]
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "candidate_services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "release_ref": {
          "type": "string"
        }
      }
    },
    "agent_goal": {
      "type": "string",
      "minLength": 20
    },
    "environment_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "health_prerequisites",
        "reset_contract"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "health_prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reset_contract": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "slo"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "slo": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observability": {
      "$ref": "#/$defs/toolRefs"
    },
    "source_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allowed_paths",
        "forbidden_paths"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "read_only"
          ]
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "action_space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_trigger_classes",
        "allowed_target_scope",
        "forbidden_actions"
      ],
      "properties": {
        "allowed_trigger_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_target_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_experiments",
        "max_duration_minutes",
        "max_concurrent_faults"
      ],
      "properties": {
        "max_experiments": {
          "type": "integer",
          "minimum": 1
        },
        "max_duration_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_concurrent_faults": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "safety_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "expected_agent_output": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "leakage_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "toolRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics",
        "traces",
        "logs",
        "kubernetes"
      ],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kubernetes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
