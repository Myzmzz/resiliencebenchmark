# Upstream credentials for the Stage-2 LiteLLM gateway sidecar.
#
# Copy this file outside the repository (for example
# "<project root>/.secrets/llm-providers.env", mode 0600), fill in the real
# values, and render/apply it with:
#
#   uv run python scripts/render_litellm_gateway.py \
#       --env-file /path/to/llm-providers.env --output-dir /tmp/litellm-render
#
# Every os.environ/NAME reference in deploy/stage2/litellm/config.yaml must be
# present here. Values are never printed by the renderer.

# Explicit alternate GPT-5.5 route (https://api.nexustokenai.com/v1); its chat
# completions prefix content with U+200B, see config.yaml
NEXUSTOKENAI_API_KEY=

# GPT-5.5 harness default route (https://api2.aigcbest.top/v1, new-api relay)
AIGCBEST_API_KEY=

# DeepSeek official API (https://api.deepseek.com)
DEEPSEEK_API_KEY=

# Alibaba Cloud DashScope OpenAI-compatible mode
# (https://dashscope.aliyuncs.com/compatible-mode/v1)
DASHSCOPE_API_KEY=

# Acucompute console (claude-opus-5 over Anthropic protocol, gpt-5.6-sol)
ACUCOMPUTE_API_KEY=

# The proxy's own bearer token. Stage-2 pods present it as RESBENCH_LLM_API_KEY
# (Secrets resbench-stage2-runtime / resbench-stage2-runtime-e2e, key
# llm-api-key), so reuse the value already deployed there unless you rotate
# both sides together.
LITELLM_MASTER_KEY=
