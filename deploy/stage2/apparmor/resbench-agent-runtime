#include <tunables/global>

# Dedicated to the trusted AgentExec initializer. Mirrors Docker's baseline
# proc/sys protections; mount access is implicit-deny except for four sandbox
# operations below. Guest code runs only after all capabilities are dropped.
profile resbench-agent-runtime flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=resbench-agent-runtime,
  ptrace (trace,read,tracedby,readby) peer=resbench-agent-runtime,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # Only after CLONE_NEWNS|CLONE_NEWNET in the trusted initializer:
  mount options=(rw,rprivate) -> /,
  remount options=(ro) /,
  mount options=(rw,bind) /var/lib/resbench-stage2/sandbox-trials/*/.sandbox-tmp/ -> /var/lib/resbench-stage2/sandbox-trials/*/.sandbox-tmp/,
  remount options=(rw,bind) /var/lib/resbench-stage2/sandbox-trials/*/.sandbox-tmp/,
}
